# ---------------------------------------------------------------------------
# Cinema Radar - copy this file to .env and fill in the values.
# Never commit .env.
# ---------------------------------------------------------------------------

# Required: token from @BotFather
BOT_TOKEN=123456789:replace-me

# Required: your numeric Telegram user id (get it from @userinfobot)
ADMIN_ID=123456789

# Optional: the Vodafone Cash / InstaPay number shown to users.  Keep it here,
# never in source code.  Leave empty to hide the manual donation flow.
DONATION_PHONE=01000000000

# Optional: public channel id (for example -1001234567890). Leave empty to
# disable channel posts.
CHANNEL_ID=

# Optional: bot @username without the @. Used to build deep links such as
# t.me/<bot>?start=w<watch_id>. It is filled automatically from bot.me() at
# startup, so this is only needed for offline tooling.
BOT_USERNAME=

# UI renderer: auto = Bot API 10.3 rich messages with automatic classic
# fallback, rich = always try rich, classic = HTML + inline keyboards only.
UI_RENDERER=auto

# ---------------------------------------------------------------------------
# Storage / logging
# ---------------------------------------------------------------------------
DB_PATH=cinemaradar.sqlite3
LOG_LEVEL=INFO
TIMEZONE=Africa/Cairo

# ---------------------------------------------------------------------------
# Cinema provider / upstream
# ---------------------------------------------------------------------------
# Comma-separated list of enabled cinemas.  Both VOX and Renaissance are on by
# default; remove one to run single-cinema mode.  PROVIDER is kept for
# backward-compat as the fallback brand when only one cinema is configured.
PROVIDERS=vox,renaissance
PROVIDER=vox
VOX_BASE_URL=https://egy.voxcinemas.com
RENAISSANCE_BASE_URL=https://rnscinemas.com

# Leave empty to use plain httpx.  VOX commonly resets plain clients, so
# "chrome124" (requires curl_cffi, installed by requirements.txt) is the
# recommended value.
HTTP_IMPERSONATE=chrome124

# Optional override; normally leave the default realistic UA.
# HTTP_USER_AGENT=

# Strict low-volume defaults.  Do not raise these casually.
GLOBAL_RATE_LIMIT=1.0
MAX_CONNECTIONS=2
REQUEST_TIMEOUT=12
MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Polling / adaptive intervals (seconds unless noted)
# ---------------------------------------------------------------------------
POLL_OPEN_WITH_SEATS=100
POLL_WAITING_FOR_OPEN=60
POLL_SOLD_OUT=120
POLL_FAR_MIN=480
POLL_FAR_MAX=720
POLL_BURST=12
POLL_OPENING_WINDOW_MINUTES=90
POLL_JITTER=0.20
WATCH_CONFIRM_DELAY=3
WATCH_ALERT_COOLDOWN=600
WATCHER_TICK=1
FAR_DATE_DAYS=7

# "All available days" follows: technical cap on expanded days per watch, and
# how often the branch date list is refreshed (seconds).
ALL_DATES_MAX=21
ALL_DATES_REFRESH=1200

# Closed watches are hard-deleted (with their baselines) after this many days.
WATCH_RETENTION_DAYS=3

# "All cinemas" watch: shows before this hour are "morning", at/after "evening".
MORNING_END_HOUR=17

# ---------------------------------------------------------------------------
# IMAX indicator
# ---------------------------------------------------------------------------
# Local snapshot generated by scripts/update_imax_list.py.  The bot never
# fetches Wikipedia at runtime.
IMAX_DATA_PATH=data/imax_films.json

# Optional TMDB read access token.  Used only to normalise a movie title/year
# before matching, never as the source of truth for IMAX.  Leave empty to skip.
# Keep secrets in .env only and rotate any token that has been shared.
TMDB_READ_TOKEN=
TMDB_TIMEOUT=10

# ---------------------------------------------------------------------------
# Discovery / broadcast
# ---------------------------------------------------------------------------
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL=480
DISCOVERY_JITTER=0.20
DISCOVERY_CONFIRM_DELAY=3
DISCOVERY_CONFIRM_NETWORK=false
DISCOVERY_DAILY_CAP=10
DISCOVERY_FLAP_WINDOW=1800
COMING_SOON_INTERVAL=3600

TELEGRAM_RATE_PER_SECOND=25
TELEGRAM_PER_CHAT_PER_SECOND=1

# ---------------------------------------------------------------------------
# Limits / support
# ---------------------------------------------------------------------------
# Two free watches. A one-off manual donation of at least 50 EGP (approved by
# the admin) raises the limit to 10. Telegram Stars are not supported.
FREE_WATCH_LIMIT=2
SUPPORTER_WATCH_LIMIT=10
DONATION_MIN_AMOUNT=50
USER_RATE_LIMIT_PER_MINUTE=20
QUIET_START=23
QUIET_END=8

# ---------------------------------------------------------------------------
# Circuit breaker / backoff
# ---------------------------------------------------------------------------
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_PAUSE_MIN=120
CIRCUIT_PAUSE_MAX=240
CIRCUIT_PROBE_TIMEOUT=20
BACKOFF_GLOBAL_MAX=8
BACKOFF_RECOVERY_STEP=0.15

# ---------------------------------------------------------------------------
# Cache TTLs (seconds)
# ---------------------------------------------------------------------------
CACHE_STATIC_TTL=64800
CACHE_LISTINGS_TTL=720
CACHE_SHOWTIMES_TTL=150
CACHE_COMING_SOON_TTL=3600
CACHE_MOVIE_DETAILS_TTL=604800
CACHE_STALE_TTL=604800

# Renaissance pre-book dates (Coming Soon titles bookable beyond the branch's
# ten-day strip). Refreshed in the background; lower = dates appear faster.
PREBOOK_DATES_TTL=10800
PREBOOK_DATES_MAX_DAYS=120

# ---------------------------------------------------------------------------
# Stats
# ---------------------------------------------------------------------------
STATS_UPDATE_HOUR=0
DAILY_STATS_DAYS=30
BROADCAST_LOG_DAYS=90
