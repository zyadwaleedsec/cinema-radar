# Normalise line endings so Windows and Linux checkouts produce identical diffs.
* text=auto eol=lf

*.py   text
*.md   text
*.txt  text
*.toml text
*.ini  text
*.json text
*.yml  text
*.yaml text

# Binaries and local databases must never be line-ending converted.
*.sqlite3 binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
